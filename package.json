{
  "name": "@book-inventory/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:public-site": "nx serve public-site",
    "start:admin": "nx serve admin",
    "start:member": "nx serve member",
    "build:all": "nx run-many -t build",
    "clean:dist": "node -e \"require('fs').rmSync('dist/apps',{recursive:true,force:true})\"",
    "build:single": "npm run clean:dist && nx build public-site --configuration=development && nx build admin --configuration=development && nx build member --configuration=development",
    "build:single:prod": "npm run clean:dist && nx build public-site --configuration=production && nx build admin --configuration=production && nx build member --configuration=production",
    "serve:single": "node scripts/serve-single.mjs",
    "start:single": "npm run build:single && npm run serve:single",
    "start:single:dev": "npm run build:single && npm run serve:single",
    "start:single:prod": "npm run build:single:prod && npm run serve:single",
    "dev": "concurrently -n build,server -c blue,green \"npx nx run-many -t build --configuration=development --watch\" \"node scripts/serve-single.mjs\"",
    "deploy": "node scripts/production-deploy.js",
    "deploy:copy": "node scripts/production-deploy.js --copy",
    "deploy:api": "node scripts/production-deploy.js --api",
    "lint:all": "nx run-many -t lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.9",
    "@angular/common": "21.2.9",
    "@angular/compiler": "21.2.9",
    "@angular/cdk": "21.2.9",
    "@angular/material": "21.2.9",
    "@angular/core": "21.2.9",
    "@angular/forms": "21.2.9",
    "@angular/platform-browser": "21.2.9",
    "@angular/router": "21.2.9",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@types/qrcode": "^1.5.6",
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "ng2-charts": "^10.0.0",
    "ngx-toastr": "^20.0.5",
    "primeng": "^21.1.9",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vis-data": "^8.0.4",
    "vis-network": "^10.0.3",
    "zone.js": "0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.7",
    "@angular-devkit/core": "21.2.7",
    "@angular-devkit/schematics": "21.2.7",
    "@angular/build": "21.2.7",
    "@angular/cli": "21.2.7",
    "@angular/compiler-cli": "21.2.9",
    "@angular/language-service": "21.2.9",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.0.1",
    "@nx/devkit": "23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/web": "23.0.1",
    "@nx/workspace": "23.0.1",
    "@schematics/angular": "21.2.7",
    "@swc/helpers": "~0.5.18",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "21.3.1",
    "autoprefixer": "^10.5.3",
    "concurrently": "^10.0.3",
    "esbuild": "^0.27.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jiti": "2.4.2",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.0.1",
    "postcss": "^8.5.19",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
